# Build context hygiene. Without this the whole node_modules tree and every
# .next cache is uploaded to the daemon on every build - slow, and it lets a
# stale local artifact leak into an image that is supposed to be reproducible.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.git
.claude
*.log
.env
.env.*
secrets
