# PanasaHRM - environment variable reference (LOCAL DEVELOPMENT)
#
# ---------------------------------------------------------------------------------------------
# WHY THIS FILE IS `env.example` AND NOT `.env.example`
#
# `CLAUDE.md` lists writing to `.env*` under Forbidden Actions, and `.claude/settings.json`
# hard-denies `Write(**/.env.*)`. Those guards exist because that filename pattern is where real
# secrets live, and a guard with an exception is a guard you cannot rely on.
#
# Note that `.gitignore` line 15 says `!.env.example`, i.e. the repository DOES expect a file by
# that name to be tracked. That is a genuine contradiction between the ignore rules and the
# governance rules, and it needs a human decision - see DEC-108. Renaming this file is a
# `git mv` once that is settled.
#
# NOTHING IN THIS FILE IS SECRET. Every value is a local-development default that is already
# committed elsewhere in the repo (docker-compose.dev.yml, scripts/seed.mjs). Copy it to a real
# env file only if you need to override something:
#
#     cp env.example .env        # .env is gitignored
#
# FOR PRODUCTION, DO NOT USE THIS FILE. The deployed stack reads
# `infrastructure/compose/prod.env`, whose template is
# `infrastructure/compose/prod.env.template` and whose values must be freshly generated
# secrets. See DEPLOY.md.
# ---------------------------------------------------------------------------------------------


# --- API process ------------------------------------------------------------------------------

# Port the NestJS API listens on. The web app's dev proxy assumes 4000.
PORT=4000


# --- PostgreSQL ---------------------------------------------------------------------------------
#
# The dev stack (infrastructure/compose/docker-compose.dev.yml) publishes Postgres on 55432, not
# 5432: a locally installed PostgreSQL already owns the standard port on at least one machine
# here, so the standard port makes `docker compose up` fail out of the box (DEC-009).

PGHOST=127.0.0.1
PGPORT=55432
PGUSER=hrm
PGPASSWORD=hrm_dev_only
PGDATABASE=hrm

# Fallback consulted by scripts/migrate.mjs and scripts/seed.mjs when PGPORT is unset. Set PGPORT
# instead; this exists so the dev compose file's own HRM_PG_PORT override reaches the scripts.
#HRM_PG_PORT=55432


# --- Object storage (MinIO) ---------------------------------------------------------------------
#
# Employee documents and payslip PDFs. The dev stack publishes the API on 59000 and the console
# on 59001.

HRM_MINIO_HOST=127.0.0.1
HRM_MINIO_PORT=59000
HRM_MINIO_SSL=false
HRM_MINIO_ACCESS_KEY=hrm_minio
HRM_MINIO_SECRET_KEY=minio_dev_only

# Renaming this after documents exist orphans everything in the old bucket.
HRM_DOC_BUCKET=hrm-documents


# --- Session cookie -------------------------------------------------------------------------
#
# ONE switch drives BOTH the `Secure` flag and the `__Host-` name prefix (apps/api/src/auth.ts,
# ADR-0010). It is deliberately not two, because the two states you can reach with two switches
# are both broken: a browser refuses a `Secure` cookie over plain HTTP, and refuses a `__Host-`
# cookie that is not `Secure`. Deriving both from one value means a half-configured deployment
# cannot exist.
#
#   false -> `hrm_session`, no Secure          local HTTP development  <- the default, and correct here
#   true  -> `__Host-hrm_session`, Secure      ANY https deployment
#
# Leave this false locally. Turning it on over http://localhost means you cannot log in at all,
# because the browser will not store the cookie the server sets.
HRM_SECURE_COOKIES=false


# --- Web app ------------------------------------------------------------------------------------
#
# BOTH OF THESE ARE BUILD-TIME. Next evaluates next.config.ts during `next build`: it resolves
# basePath and serialises rewrites() into routes-manifest.json. Setting either at runtime does
# nothing at all - a mistake that cost a debugging session, see DEC-103.

# Where the web app forwards /api/* in development. In the deployed stack nginx routes /api/
# straight to the API container and this rewrite is never exercised.
HRM_API_ORIGIN=http://localhost:4000

# Public path prefix. Empty = served at the root, which is what local development and every
# check in testing/demo assume. Production uses /panasa-hrm (no trailing slash).
NEXT_PUBLIC_BASE_PATH=


# --- Seed and test tooling ------------------------------------------------------------------
#
# Only read by scripts/ and testing/. Not needed to run the app.

# Shared password for every demo account created by `npm run db:seed`.
HRM_DEMO_PASSWORD=panasa2026

# Base URL the payslip test uses to reach MinIO directly.
#HRM_MINIO_URL=http://127.0.0.1:59000

# --- THE TWO SAFETY GUARDS. Do not set either of these in a shell you keep. -------------------
#
# Both scripts refuse to touch anything that is not the dev target (127.0.0.1:55432/hrm), and
# both take the same literal string `i-understand` to proceed anyway. They are commented out on
# purpose: an override that lives in your environment is not an override, it is the new default.
#
# `db:verify` WRITES to the database it runs against - every script is rolled back, but a
# rollback still takes locks and still writes WAL.
#HRM_VERIFY_ALLOW_NONDEV=i-understand
#
# `db:seed` DELETES and recreates every table it touches.
#HRM_SEED_ALLOW_NONDEV=i-understand


# --- The HR assistant (ADR-0020) ----------------------------------------------------------------
#
# OFF BY DEFAULT, and both of these must be set before it does anything. ADR-0020: "a deployment
# that has not chosen this has not taken the dependency." With the switch off, the panel still
# opens and every question is answered with a plain refusal rather than an error.
#
# WHAT IS SENT TO THE MODEL. The question the user typed, the tool catalogue, and - for the
# answer - THE RESULT ROWS, exactly as the asker is being shown them. That last part is DEC-140,
# which reversed ADR-0020 section 3 so the assistant could state a figure instead of describing a
# table. It is a cross-border transfer of personal data: see docs/privacy/data-inventory.md gap 7.

HRM_ASSISTANT_ENABLED=false

# Set to false to restore the original ADR-0020 posture: the model is told the column names and
# the row count and nothing else, and the sentence above each table is written in our own code.
# The assistant still works; it just introduces the table rather than answering in words.
#HRM_LLM_ANSWER_FROM_ROWS=true

# Set to false if the provider rejects streamed answers (some gateways and Azure
# deployments reject stream_options). The assistant retries without streaming automatically and
# warns when it does; this skips the wasted first attempt. DEC-148.
#HRM_LLM_STREAM=true

# The key. LOCALLY this plain variable is the convenient path; for a deployment prefer
# HRM_LLM_API_KEY_FILE, which the code uses in preference when both are set (DEC-129/DEC-139).
#HRM_LLM_API_KEY=sk-...
#HRM_LLM_API_KEY_FILE=/run/secrets/hrm_llm_api_key

# Optional. The defaults are the OpenAI platform and gpt-4o-mini; a different base URL covers
# Azure OpenAI or a gateway without a second adapter.
#HRM_LLM_MODEL=gpt-4o-mini
#HRM_LLM_BASE_URL=https://api.openai.com/v1
#HRM_LLM_TIMEOUT_MS=12000
