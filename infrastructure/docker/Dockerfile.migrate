# =============================================================================
# ART HRM - migration runner (one-shot)
# =============================================================================
#
# ADR-0013: migrations run as a SEPARATE one-shot container, never on app boot.
# An app-boot migration means replicas race each other, and a failed migration
# takes the application down with it instead of just failing the deploy.
#
# It needs BOTH node and psql: scripts/migrate.mjs is Node, and it shells out to
# `psql` deliberately (DEC-013) so the migration path has no driver dependency
# of its own and the SQL that runs is the SQL in the file.
#
#     docker build -f infrastructure/docker/Dockerfile.migrate \
#       -t art-hrm-migrate:<tag> .
# =============================================================================

FROM node:24-alpine

# postgresql-client only - no server. Pinned to the major version the schema
# targets so client and server never disagree about syntax.
RUN apk add --no-cache postgresql17-client || apk add --no-cache postgresql-client

WORKDIR /repo

# Only what the runner reads. It has no dependencies beyond Node's stdlib, so
# there is no install step and nothing to keep patched.
COPY scripts/migrate.mjs            scripts/migrate.mjs
COPY infrastructure/db/migrations   infrastructure/db/migrations
COPY testing/db                     testing/db

USER node

# `up` applies pending migrations and refuses any file whose checksum no longer
# matches what was applied. Exits non-zero on failure, which is what makes it
# usable as a deploy gate.
ENTRYPOINT ["node", "scripts/migrate.mjs"]
CMD ["up"]
