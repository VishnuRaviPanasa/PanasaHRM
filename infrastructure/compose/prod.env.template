# PanasaHRM production environment - TEMPLATE.
#
#   cp infrastructure/compose/prod.env.template infrastructure/compose/prod.env
#   # then fill in every REQUIRED value with a freshly generated secret
#
# `prod.env` is gitignored and must never be committed. This file is deliberately NOT named
# `.env.example`: writing to `.env*` is a Forbidden Action in CLAUDE.md, and the guard is worth
# more than the naming convention.
#
# Generate each secret separately, e.g.
#   openssl rand -base64 30 | tr -d '/+=' | cut -c1-32
#
# The stack reads this file via `docker compose --env-file`. The REQUIRED values have no default,
# and the deploy fails naming any that is missing.

# --- REQUIRED: PostgreSQL, owner role -------------------------------------------------------
# Creates the cluster on first boot, and is what the MIGRATION runner connects with. Creating
# tables, constraints and triggers needs the owner - that is the one place it is correct.
#
# Changing PGPASSWORD later does NOT change the role's password: initdb only runs against an
# empty volume. Use ALTER ROLE, then update this file.
PGDATABASE=hrm
HRM_PG_OWNER_USER=hrm
HRM_PG_OWNER_PASSWORD=

# --- REQUIRED: PostgreSQL, application role -------------------------------------------------
# What the API connects with. It SHOULD be a least-privilege role (`hrm_app`, migration 0008) -
# that is the whole point of separating them, and while the API connects as the owner it
# bypasses every grant including the Tier-1 revokes on the payslip tables (OR-29).
#
# BUT SET THESE TO THE OWNER'S CREDENTIALS FOR NOW. Finding P3-7: the leave flow cannot run as
# `hrm_app` at all, because the ledger trigger needs a grant the role lacks. Switching is a
# config change once P3-7 is fixed, which is why the variables are separate.
HRM_PG_APP_USER=hrm
HRM_PG_APP_PASSWORD=

# --- REQUIRED: MinIO ------------------------------------------------------------------------
# MINIO_ROOT_USER must be at least 3 characters, MINIO_ROOT_PASSWORD at least 8. These hold the
# employee documents; treat them as being as sensitive as the database password.
HRM_MINIO_ACCESS_KEY=
HRM_MINIO_SECRET_KEY=

# --- REQUIRED: Redis ------------------------------------------------------------------------
# Redis runs but nothing uses it yet (OR-21 - sessions are still PostgreSQL rows). It is here so
# the switch is a config change rather than a redeploy. Password it anyway: an unauthenticated
# Redis on a shared host is an invitation.
HRM_REDIS_PASSWORD=

# --- Optional -------------------------------------------------------------------------------

# Document bucket name. Changing it after documents exist orphans everything in the old bucket.
HRM_DOC_BUCKET=hrm-documents

# The MinIO web console. Off in production - it is a second authentication surface in front of
# the document store, for a stack where nothing needs it. Set to "on" only to debug, then off.
HRM_MINIO_BROWSER=off

# Loopback port the edge nginx publishes on. The host nginx upstream must match.
# Check it is free first:  ss -ltnp | grep 4787
HRM_PUBLISH_PORT=4787

# Public path prefix, when the host nginx path-routes rather than giving the app a hostname.
# BUILD-TIME: change it and the web image must be rebuilt (./deploy.sh does). It also drives the
# edge nginx's API location, so the two can never disagree.
#   ""             -> https://host:7777/              needs a dedicated server{} or subdomain
#   "/panasa-hrm"  -> https://host:7777/panasa-hrm/   no trailing slash here
NEXT_PUBLIC_BASE_PATH=/panasa-hrm

# Drives BOTH the session cookie's `Secure` flag AND its `__Host-` name prefix (ADR-0010).
# TRUE for anything reached over https, which is every deployment behind the host nginx.
# Only set false for a plain-HTTP local run - a browser refuses a Secure cookie over HTTP, and
# refuses a __Host- cookie without Secure, so a half-configured deployment fails loudly at login
# rather than quietly downgrading.
HRM_SECURE_COOKIES=true

# Image tag. `local` while images are built on the host; ADR-0013 wants a CI-built digest here
# instead - the standard this deployment has to meet, not what it does today (task T12).
HRM_IMAGE_TAG=local

# --- Demo data only -------------------------------------------------------------------------
# Required ONLY by the profiled `seed` service, which an ordinary `up` never starts:
#   docker compose ... --profile seed run --rm seed
# The seed is DESTRUCTIVE. Leave this unset for a real deployment.
HRM_DEMO_PASSWORD=
