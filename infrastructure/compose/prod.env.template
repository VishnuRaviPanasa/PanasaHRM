# PanasaHRM production environment - TEMPLATE.
#
#   cp infrastructure/compose/prod.env.template infrastructure/compose/prod.env
#   # then fill in every REQUIRED value with a freshly generated secret
#
# `prod.env` is gitignored and must never be committed. This file is deliberately NOT named
# `.env.example`: writing to `.env*` is a Forbidden Action in CLAUDE.md, and the guard is worth
# more than the naming convention.
#
# Generate each secret separately, e.g.
#   openssl rand -base64 30 | tr -d '/+=' | cut -c1-32
#
# The stack reads this file via `docker compose --env-file`. Values are substituted into
# docker-compose.prod.yml; the REQUIRED ones have no default and the deploy fails naming any
# that is missing.

# --- REQUIRED: PostgreSQL -------------------------------------------------------------------
# These create the cluster on first boot AND are what the API and the migration runner connect
# with. Changing PGPASSWORD after the first boot does NOT change the role's password - the
# initdb only runs against an empty volume; use ALTER ROLE, then update this file.
PGUSER=hrm
PGPASSWORD=
PGDATABASE=hrm

# --- REQUIRED: MinIO ------------------------------------------------------------------------
# MINIO_ROOT_USER must be at least 3 characters, MINIO_ROOT_PASSWORD at least 8. These hold the
# employee documents; treat them as being as sensitive as the database password.
HRM_MINIO_ACCESS_KEY=
HRM_MINIO_SECRET_KEY=

# --- Optional -------------------------------------------------------------------------------

# Document bucket name. Changing it after documents exist orphans everything in the old bucket.
HRM_DOC_BUCKET=hrm-documents

# The MinIO web console. Off in production - it is a second authentication surface in front of
# the document store, for a stack where nothing needs it. Set to "on" only to debug, then off.
HRM_MINIO_BROWSER=off

# Loopback port the edge nginx publishes on. The host nginx upstream must match.
HRM_PUBLISH_PORT=4787

# Public path prefix, when the host nginx path-routes rather than giving the app a hostname.
# BUILD-TIME: change it and you must rebuild the web image (./deploy.sh does).
#   ""             -> https://host:7777/           needs a dedicated server{} or subdomain
#   "/panasa-hrm"  -> https://host:7777/panasa-hrm/   no trailing slash here
NEXT_PUBLIC_BASE_PATH=/panasa-hrm

# Marks the session cookie Secure. TRUE for any deployment reached over https, which is every
# deployment behind the host nginx. Only set false for a plain-HTTP local run.
HRM_COOKIE_SECURE=true

# Image tag. `local` while images are built on the host; ADR-0013 wants a CI-built digest here
# instead - that is the standard this deployment has to meet, not what it does today (task T12).
HRM_IMAGE_TAG=local
