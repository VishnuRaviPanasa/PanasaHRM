# dependencies
node_modules/
.npm/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# env & secrets - NEVER commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# test & coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# claude local state (session-scoped, not shared)
.claude/settings.local.json
.claude/state/*.jsonl

# local data volumes
.data/
tmp/

# Hook working state - absolute machine-local paths, not project content.
# `**/` because a pattern containing a slash is anchored to this file's directory, and
# the workspaces keep their own copies (apps/api, apps/web).
**/.claude/state/dirty-files.txt

# production secrets - the deploy env file, never committed (template: prod.env.template)
infrastructure/compose/prod.env

# Local verification only - self-signed certificate, never committed
infrastructure/compose/.tls-local/
infrastructure/compose/docker-compose.verify.yml

# Generated deliverable - rebuilt from docs/runbooks/deployment.md, not a source file
ART-HRM-Deployment-Runbook.docx
