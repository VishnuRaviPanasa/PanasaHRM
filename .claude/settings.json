{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(psql *)",
      "Bash(node scripts/*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(docker compose down *)",
      "Bash(docker compose up *)",
      "Edit(docs/adr/*)",
      "Edit(ai/context/*)",
      "Edit(.claude/settings.json)",
      "Edit(packages/authz/**)",
      "Edit(infrastructure/db/migrations/*)",
      "Write(infrastructure/db/migrations/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(docker compose down -v*)",
      "Bash(npm publish*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(.mcp.json)"
    ]
  },
  "_comments": {
    "allow": "Read-only inspection and non-destructive build/test commands run without prompting.",
    "ask": "Two classes sit here deliberately: (1) anything that moves history or dependencies, and (2) packages/authz and db/migrations - the two places where a silent mistake is most expensive, where one keystroke of confirmation is proportionate.",
    "deny": "Hard blocks. `docker compose down -v` is denied because it destroys the dev database volume - an easy and irreversible accident. `.mcp.json` is denied so MCP servers are only ever added by a deliberate human edit (see plan section 26).",
    "hooks": "Four hooks, each shipping with its script (DEC-003). guard-commit combines the secret, migration and authz checks in one process to stay inside the sub-10s commit budget - a slow commit gate is what drives people to --no-verify, which this repo denies. Deferred: a Stop-hook typecheck (no TypeScript exists yet) and a push gate requiring a /gate artifact (needs code to gate). Each hook script documents what it prevents and how to remove it safely."
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.mjs",
            "timeout": 30,
            "statusMessage": "Checking staged changes for secrets, migrations, authz..."
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-adr.mjs",
            "timeout": 10,
            "statusMessage": "Checking ADR immutability (shell)..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-adr.mjs",
            "timeout": 10,
            "statusMessage": "Checking ADR immutability..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/track-dirty.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-subagent.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
